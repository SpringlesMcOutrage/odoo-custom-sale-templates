<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_custom_template" model="ir.ui.view">
        <field name="name">account.move.form.custom.template</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <field name="custom_template_id"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Standard (default template)"
                       invisible="move_type not in ['out_invoice', 'out_refund']"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_custom_print_button" model="ir.ui.view">
        <field name="name">account.move.form.custom.print.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_invoice_sent']" position="after">
                <button name="action_print_custom_template"
                        string="Print Custom"
                        type="object"
                        class="oe_highlight"
                        invisible="move_type not in ['out_invoice', 'out_refund'] or state != 'posted'"/>
            </xpath>
        </field>
    </record>
</odoo>
