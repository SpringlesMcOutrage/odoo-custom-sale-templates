<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_template_list" model="ir.ui.view">
        <field name="name">custom.template.list</field>
        <field name="model">custom.template</field>
        <field name="arch" type="xml">
            <list string="Custom Templates">
                <field name="name"/>
                <field name="model_name"/>
                <field name="template_type"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_custom_template_form" model="ir.ui.view">
        <field name="name">custom.template.form</field>
        <field name="model">custom.template</field>
        <field name="arch" type="xml">
            <form string="Custom Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_name"/>
                        </group>
                        <group>
                            <field name="template_type"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="QWeb Code" invisible="template_type != 'qweb'">
                            <field name="qweb_code" widget="ace" options="{'mode': 'xml'}"/>
                            <div class="alert alert-info mt-3" role="alert">
                                <p><strong>Available variables:</strong></p>
                                <ul>
                                    <li><code>doc</code> — current document (sale.order or account.move)</li>
                                    <li><code>doc.name</code> — document number</li>
                                    <li><code>doc.partner_id</code> — partner / customer</li>
                                    <li><code>doc.order_line</code> — order lines (for sale.order)</li>
                                    <li><code>doc.invoice_line_ids</code> — invoice lines (for account.move)</li>
                                    <li><code>doc.amount_total</code> — total amount</li>
                                </ul>
                                <p><strong>Model check example:</strong></p>
                                <div style="background: #f5f5f5; padding: 10px; border-radius: 4px;">
                                    <code>&lt;t t-if="doc._name == 'sale.order'"&gt;...&lt;/t&gt;</code><br/>
                                    <code>&lt;t t-if="doc._name == 'account.move'"&gt;...&lt;/t&gt;</code>
                                </div>
                            </div>
                        </page>
                        <page string="ODT File" invisible="template_type != 'odt'">
                            <group>
                                <field name="odt_file" filename="odt_filename"/>
                                <field name="odt_filename" invisible="1"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <p><strong>ODT template instructions:</strong></p>
                                <ul>
                                    <li>Upload the ODT template file</li>
                                    <li>Use py3o variables in the template: <code>py3o://object.name</code></li>
                                    <li>For sale.order: <code>py3o://for="line in object.order_line"</code></li>
                                    <li>For account.move: <code>py3o://for="line in object.invoice_line_ids"</code></li>
                                    <li>Amount to text function: <code>py3o://amount_to_text_ua(object.amount_total)</code></li>
                                </ul>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_custom_template_search" model="ir.ui.view">
        <field name="name">custom.template.search</field>
        <field name="model">custom.template</field>
        <field name="arch" type="xml">
            <search string="Search Templates">
                <field name="name" string="Name" filter_domain="[('name', 'ilike', self)]"/>
                <filter string="Orders" name="sale_order" domain="[('model_name', '=', 'sale.order')]"/>
                <filter string="Invoices" name="account_move" domain="[('model_name', '=', 'account.move')]"/>
                <separator/>
                <filter string="QWeb" name="qweb" domain="[('template_type', '=', 'qweb')]"/>
                <filter string="ODT" name="odt" domain="[('template_type', '=', 'odt')]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Model" name="group_model" context="{'group_by': 'model_name'}"/>
                    <filter string="Template Type" name="group_type" context="{'group_by': 'template_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_custom_template" model="ir.actions.act_window">
        <field name="name">Custom Templates</field>
        <field name="res_model">custom.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first custom template
            </p>
            <p>
                Supported documents:
            </p>
            <ul>
                <li><strong>Quotation / Sale Order</strong> — for sale.order</li>
                <li><strong>Invoice</strong> — for account.move</li>
            </ul>
            <p>
                Template types:
            </p>
            <ul>
                <li><strong>QWeb</strong> — HTML/PDF templates using QWeb syntax</li>
                <li><strong>ODT</strong> — LibreOffice templates using py3o</li>
            </ul>
        </field>
    </record>

    <menuitem id="menu_custom_templates"
              name="CUSTOM"
              parent="sale.sale_menu_root"
              sequence="100"/>

    <menuitem id="menu_custom_templates_list"
              name="Custom Templates"
              parent="menu_custom_templates"
              action="action_custom_template"
              sequence="1"/>
</odoo>
