<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_sale_order_custom" model="ir.actions.report">
        <field name="name">Custom Template (QWeb)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_sale_templates.report_sale_order_custom</field>
        <field name="report_file">custom_sale_templates.report_sale_order_custom</field>
        <field name="print_report_name">'Custom_' + (object.name or '').replace('/','_')</field>
    </record>

    <template id="report_sale_order_custom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-if="doc.custom_template_id and doc.custom_template_id.template_type == 'qweb'">
                    <div t-out="doc.render_custom_template_for_report()"/>
                </t>
                <t t-else="">
                    <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_account_move_custom" model="ir.actions.report">
        <field name="name">Custom Invoice (QWeb)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_sale_templates.report_account_move_custom</field>
        <field name="report_file">custom_sale_templates.report_account_move_custom</field>
        <field name="print_report_name">'Custom_Invoice_' + (object.name or '').replace('/','_')</field>
    </record>

    <template id="report_account_move_custom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-if="doc.custom_template_id and doc.custom_template_id.template_type == 'qweb'">
                    <div t-out="doc.render_custom_template_for_report()"/>
                </t>
                <t t-else="">
                    <t t-call="account.report_invoice_document" t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
